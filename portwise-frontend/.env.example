# Base URL of the Main API, including the /api/v1 prefix.
VITE_API_URL=http://localhost:8000/api/v1
# "true" serves every API call from the in-browser mock (MSW) and shows a "Demo data" badge.
# Leave "false" once the real API is reachable. ?demo=1 on any URL also turns mocks on.
VITE_USE_MOCKS=true
VITE_SITE_URL=http://localhost:5173
