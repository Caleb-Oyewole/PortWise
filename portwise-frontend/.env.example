# Base URL of the PortWise API (no trailing slash, no /api/v1).
# Live: https://portwise.rumptycloud.app   Local: http://localhost:8000
VITE_API_URL=https://portwise.rumptycloud.app
# "true" serves every API call from the in-browser mock (MSW) and shows a "Demo data" badge.
# ?demo=1 on any URL also turns mocks on (?demo=0 turns them off).
VITE_USE_MOCKS=false
# Absolute site URL, used for the share-preview image.
VITE_SITE_URL=http://localhost:5173
